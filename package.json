{
  "name": "opsgrid",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @opsgrid/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "generate": "pnpm --filter @opsgrid/api-client generate",
    "lint:api": "redocly lint api/openapi.yaml"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@redocly/cli": "2.57.0",
    "squawk-cli": "2.66.0"
  }
}
