# Copy to .env to override local development defaults. Never commit .env.
# Every value below is a LOCAL DEVELOPMENT default baked into compose.yaml.

# PostgreSQL superuser (container only)
POSTGRES_PASSWORD=opsgrid-dev-superuser

# Application roles (db/bootstrap/roles.sql)
OPSGRID_MIGRATOR_PASSWORD=opsgrid-dev-migrator
OPSGRID_APP_PASSWORD=opsgrid-dev-app
OPSGRID_WORKER_PASSWORD=opsgrid-dev-worker
OPSGRID_RELAY_PASSWORD=opsgrid-dev-relay
OPSGRID_REPORTING_RO_PASSWORD=opsgrid-dev-reporting

# Keycloak bootstrap admin (http://localhost:8180)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=opsgrid-dev-admin

# OIDC client secret for the BFF (must match infra/keycloak/realm-opsgrid.json)
OIDC_CLIENT_SECRET=opsgrid-dev-bff-secret

# Telemetry: empty disables export. `make dev-obs` sets it to otel-collector:4317.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Log level: debug | info | warn | error
LOG_LEVEL=info
